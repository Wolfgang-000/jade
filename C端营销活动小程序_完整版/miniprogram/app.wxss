
page{background:#f7f5f2;color:#25211f;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}
.page{min-height:100vh;padding-bottom:140rpx}
.container{padding:0 32rpx}
.text-secondary{color:#756e69}.text-tertiary{color:#9e9690}.brand{color:#9b1c1f}.gold{color:#a9874e}
.section{padding:48rpx 32rpx 0}.section-title{font-size:38rpx;line-height:1.3;font-weight:600;letter-spacing:-1rpx}.section-sub{font-size:24rpx;color:#8b837d;margin-top:10rpx;line-height:1.6}
.btn-primary{height:88rpx;display:flex;align-items:center;justify-content:center;background:#9b1c1f;color:#fff;border-radius:12rpx;font-size:28rpx;font-weight:600}.btn-secondary{height:80rpx;display:flex;align-items:center;justify-content:center;background:#fff;color:#332e2a;border:1rpx solid #ddd7d1;border-radius:12rpx}
.divider{height:1rpx;background:#ebe6e0}.surface{background:#fff}.hairline{border:1rpx solid #ebe6e0}
.safe-bottom{padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}
