.cart-page{min-height:100vh;background:#f7f4ef}.cart-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:34rpx 32rpx 24rpx;background:#fbfaf8}.cart-title{font-size:42rpx;font-weight:650;letter-spacing:-1rpx}.cart-sub{font-size:21rpx;color:#8e8781;line-height:1.6;margin-top:7rpx}.continue-btn{height:58rpx;padding:0 18rpx;border:1rpx solid #dcd5ce;border-radius:999rpx;background:#fff;color:#514b46;font-size:21rpx;display:flex;align-items:center}.member-note{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:24rpx 32rpx;background:#2b2825;color:#f8f5f1}.member-note-title{font-size:25rpx;font-weight:650}.member-note-sub{font-size:20rpx;color:#bfb7b0;line-height:1.55;margin-top:6rpx}.member-saving{font-size:23rpx;color:#d8c49f;white-space:nowrap}.cart-select-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 32rpx;background:#fff;border-bottom:1rpx solid #e9e3dc}.select-all,.footer-select{display:flex;align-items:center;gap:12rpx;font-size:23rpx}.cart-count-copy{font-size:20rpx;color:#9a938d}.cart-list{background:#fff}.premium-cart-item{grid-template-columns:42rpx 176rpx 1fr;align-items:flex-start;padding-top:26rpx;padding-bottom:26rpx}.cart-content{min-width:0}.cart-name{font-size:28rpx;font-weight:650;line-height:1.45}.cart-meta{font-size:21rpx;color:#8d857f;margin-top:7rpx}.cart-status-row{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:12rpx}.cart-stock,.cart-member-tag{min-height:36rpx;padding:0 10rpx;border-radius:5rpx;display:flex;align-items:center;font-size:18rpx}.cart-stock{background:#edf4ef;color:#52705d}.cart-stock-warn{background:#fbf1e5;color:#966728}.cart-member-tag{background:#f3eee8;color:#6f5a46}.cart-price-line{display:flex;align-items:flex-end;justify-content:space-between;gap:12rpx;margin-top:14rpx}.cart-price{font-size:31rpx;font-weight:650}.cart-old{font-size:20rpx;color:#aaa19b;text-decoration:line-through;margin-left:8rpx}.remove-btn{font-size:20rpx;color:#8d857f;padding:0;background:transparent}.premium-quantity{display:inline-flex;margin-top:16rpx}.cart-summary{margin-top:18rpx;padding:24rpx 32rpx;background:#fff;border-top:1rpx solid #e8e2db;border-bottom:1rpx solid #e8e2db}.summary-line{display:flex;align-items:center;justify-content:space-between;font-size:23rpx;padding:8rpx 0}.summary-line.saving{color:#6f5a46}.summary-line.total{font-size:27rpx;font-weight:650;padding-top:14rpx;margin-top:8rpx;border-top:1rpx solid #ece7e0}.summary-help{font-size:19rpx;color:#9a938d;line-height:1.55;margin-top:10rpx}.premium-cart-footer{grid-template-columns:auto 1fr 210rpx;align-items:center;gap:16rpx}.footer-total{display:flex;flex-direction:column;align-items:flex-end}.footer-label{font-size:19rpx;color:#8d857f}.footer-price{font-size:31rpx;font-weight:700}.footer-meta{font-size:18rpx;color:#9d958f;margin-top:2rpx}.checkout-btn{height:78rpx;min-height:78rpx;font-size:25rpx}.premium-empty{padding:160rpx 56rpx 0}.empty-kicker{font-size:18rpx;letter-spacing:4rpx;color:#8e765f;margin-bottom:18rpx}.empty-button{margin:32rpx auto 0;width:280rpx}.continue-btn::after,.remove-btn::after{border:0}
