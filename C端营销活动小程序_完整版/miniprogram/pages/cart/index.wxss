.cart-page{min-height:100vh;background:var(--bg)}
.cart-page--has-footer{padding-bottom:calc(112rpx + env(safe-area-inset-bottom))}
.cart-head{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:20rpx;padding:22rpx 28rpx 18rpx;background:var(--surface-soft);border-bottom:1rpx solid var(--border);position:sticky;top:0;z-index:12}
.cart-title{font-size:36rpx;font-weight:700;letter-spacing:-1rpx;white-space:nowrap}
.cart-head-actions{min-width:0;display:flex;align-items:center;justify-content:flex-end;gap:16rpx}
.cart-search{width:360rpx;max-width:100%;height:58rpx;min-width:0;display:flex;align-items:center;gap:10rpx;padding:0 18rpx;background:#F1EEEA;border-radius:999rpx}
.cart-search-icon{font-size:24rpx;color:#8D857F;flex:none}
.cart-search-input{flex:1;min-width:0;height:58rpx;font-size:21rpx;color:#332F2C}
.cart-search-placeholder{color:#A29A94}
.cart-search-clear{width:34rpx;height:34rpx;flex:0 0 34rpx;border-radius:50%;background:#D8D1C9;color:#fff;font-size:24rpx;line-height:32rpx;text-align:center}
.manage-btn{height:54rpx;min-width:64rpx;padding:0;background:transparent;color:#4D4742;font-size:22rpx;font-weight:600;display:flex;align-items:center;justify-content:center;white-space:nowrap;border:0;border-radius:0}
.manage-btn--disabled{opacity:.35}

.cart-select-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:76rpx;padding:0 32rpx;background:#fff;border-bottom:1rpx solid var(--border)}
.select-all,.footer-select{display:flex;align-items:center;gap:12rpx;font-size:23rpx;line-height:1;white-space:nowrap;flex:none}
.cart-count-copy{min-width:0;font-size:20rpx;color:var(--text-3);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;text-align:right}
.cart-list{background:#fff}
.premium-cart-item{display:grid;grid-template-columns:42rpx 160rpx minmax(0,1fr);align-items:center;gap:18rpx;padding:26rpx 32rpx;background:#fff;border-bottom:1rpx solid var(--divider)}
.premium-cart-item:last-child{border-bottom:0}
.cart-content{min-width:0;align-self:stretch;display:flex;flex-direction:column}
.cart-img{width:160rpx;height:160rpx;background:#EEE9E3}
.cart-name{min-width:0;font-size:28rpx;font-weight:650;line-height:1.42;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}
.cart-meta{font-size:21rpx;color:var(--text-2);margin-top:7rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cart-maker{font-size:19rpx;color:var(--text-3);line-height:1.45;margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cart-status-row{display:flex;gap:8rpx;flex-wrap:wrap;margin-top:10rpx;min-width:0}
.cart-stock,.cart-member-tag{min-height:36rpx;max-width:100%;padding:0 10rpx;border-radius:5rpx;display:flex;align-items:center;font-size:18rpx;line-height:1.3}
.cart-stock{background:#EDF4EF;color:#52705D}
.cart-stock-warn{background:#FBF1E5;color:#966728}
.cart-member-tag{background:#F3EEE8;color:#6F5A46}
.cart-price-line{display:flex;align-items:flex-end;justify-content:space-between;gap:12rpx;margin-top:12rpx;min-width:0}
.cart-price-block{min-width:0;display:flex;align-items:baseline;gap:12rpx;flex-wrap:wrap}
.cart-price{font-size:30rpx;font-weight:700;letter-spacing:-.5rpx;white-space:nowrap}
.cart-line-total{font-size:19rpx;color:#8D857F;white-space:nowrap}
.cart-item-actions{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:14rpx}
.remove-btn{font-size:20rpx;color:#8D857F;padding:0;background:transparent;white-space:nowrap;flex:none;border:0;border-radius:0}

.premium-quantity{display:grid;grid-template-columns:58rpx 74rpx 58rpx;align-items:center;width:190rpx;height:56rpx;margin:0;background:#fff;border:1rpx solid #E1DBD4;flex:none}
.premium-quantity .qty-btn{width:58rpx;height:54rpx;font-size:27rpx;border:0;border-radius:0;background:#fff}
.premium-quantity .qty-value{min-width:74rpx;height:54rpx;display:flex;align-items:center;justify-content:center;line-height:54rpx;border-left:1rpx solid var(--divider);border-right:1rpx solid var(--divider)}
.manage-item-hint{font-size:19rpx;color:#8D857F;margin-top:16rpx}

.checkbox{width:34rpx;height:34rpx;min-width:34rpx;flex:0 0 34rpx;align-self:center;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--border-2);border-radius:50%;position:relative;background:#fff}
.checkbox.checked{background:var(--brand);border-color:var(--brand)}
.checkbox.checked:after{content:"✓";position:absolute;left:50%;top:50%;transform:translate(-50%,-54%);color:#fff;font-size:22rpx;line-height:1}
.item-checkbox{align-self:center}

.cart-summary{margin-top:18rpx;padding:24rpx 32rpx;background:#fff;border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)}
.summary-line{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:23rpx;padding:8rpx 0}
.summary-line>text:first-child{min-width:0}
.summary-line>text:last-child{white-space:nowrap;flex:none}
.summary-line.total{font-size:27rpx;font-weight:650;padding-top:14rpx;margin-top:8rpx;border-top:1rpx solid var(--divider)}
.summary-help{font-size:19rpx;color:var(--text-3);line-height:1.55;margin-top:10rpx}

.premium-empty{padding:58rpx 48rpx 48rpx}
.cart-empty-under-head{min-height:280rpx;background:var(--bg)}
.empty-button{margin:26rpx auto 0;width:250rpx}
.cart-search-empty{min-height:320rpx;padding:88rpx 48rpx 48rpx;text-align:center;background:var(--bg);display:flex;flex-direction:column;align-items:center}
.cart-search-empty .strong{font-size:28rpx}
.cart-search-empty>text:nth-child(2){font-size:21rpx;color:#8D857F;margin-top:10rpx}
.cart-search-reset{margin-top:20rpx;font-size:22rpx}

.recommend-section{margin-top:22rpx;padding:34rpx 32rpx 20rpx;background:var(--surface-soft);border-top:1rpx solid var(--border)}
.recommend-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20rpx;margin-bottom:24rpx}
.recommend-head>view{min-width:0}
.recommend-title{font-size:34rpx;font-weight:650;letter-spacing:-1rpx}
.recommend-sub{font-size:21rpx;color:#8D857F;line-height:1.55;margin-top:7rpx;overflow-wrap:anywhere}
.recommend-all{font-size:21rpx;color:#6D5945;white-space:nowrap;flex:none}
.recommend-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:30rpx 18rpx}
.recommend-card{min-width:0;display:flex;flex-direction:column}
.recommend-image-wrap{position:relative;height:250rpx;background:#EEE9E3;overflow:hidden;border:1rpx solid #E7E1DA}
.recommend-image{width:100%;height:100%;display:block}
.recommend-reason{position:absolute;left:10rpx;top:10rpx;min-height:34rpx;max-width:calc(100% - 20rpx);padding:0 9rpx;display:flex;align-items:center;background:rgba(255,255,255,.94);color:#6D5945;font-size:17rpx;letter-spacing:.5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recommend-name{font-size:25rpx;font-weight:650;line-height:1.4;margin-top:13rpx;min-height:70rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;overflow-wrap:anywhere}
.recommend-meta,.recommend-maker{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recommend-meta{font-size:19rpx;color:var(--text-2);margin-top:5rpx}
.recommend-maker{font-size:18rpx;color:var(--text-3);margin-top:3rpx}
.recommend-stock{font-size:18rpx;color:#627466;line-height:1.5;margin-top:8rpx;min-height:28rpx;overflow-wrap:anywhere}
.recommend-bottom{display:flex;flex-direction:column;align-items:stretch;gap:12rpx;margin-top:14rpx}
.recommend-price-line{width:100%;min-width:0;display:flex;align-items:baseline;gap:8rpx;white-space:nowrap;overflow:hidden}
.recommend-price-label{font-size:18rpx;line-height:1.2;color:#8D857F;white-space:nowrap;flex:none}
.recommend-price{min-width:0;font-size:30rpx;line-height:1.1;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.recommend-add{width:100%;height:58rpx;min-width:0;padding:0 12rpx;border:1rpx solid #CFC7BF;background:#fff;color:#514B46;font-size:19rpx;font-weight:600;display:flex;align-items:center;justify-content:center;white-space:nowrap;border-radius:var(--radius-sm)}

.cart-footer{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#fff;border-top:1rpx solid var(--border);padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom))}
.premium-cart-footer{display:flex;align-items:center;gap:16rpx}
.footer-select{min-width:92rpx}
.footer-total{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center}
.footer-total-row{max-width:100%;display:flex;align-items:baseline;justify-content:flex-end;gap:8rpx;white-space:nowrap;min-width:0}
.footer-label{font-size:18rpx;color:#8D857F;flex:none}
.footer-price{min-width:0;max-width:100%;font-size:31rpx;font-weight:700;line-height:1.08;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.footer-meta{font-size:18rpx;color:#9D958F;margin-top:4rpx;white-space:nowrap}
.checkout-btn{flex:0 0 204rpx;width:204rpx;height:76rpx;min-height:76rpx;padding:0 16rpx;font-size:24rpx;white-space:nowrap;border-radius:var(--radius-md)}
.manage-footer{display:flex;align-items:center;gap:18rpx}
.manage-actions{flex:1 1 auto;min-width:0;display:flex;justify-content:flex-end;gap:12rpx}
.manage-secondary,.manage-danger{height:68rpx;min-width:0;flex:1 1 0;padding:0 16rpx;border-radius:var(--radius-md);font-size:22rpx;font-weight:600;display:flex;align-items:center;justify-content:center;white-space:nowrap}
.manage-secondary{background:#fff;border:1rpx solid #CFC7BF;color:#514B46}
.manage-danger{background:var(--brand);color:#fff;border:0}
.manage-secondary[disabled],.manage-danger[disabled]{opacity:.35}

@media (max-width:360px){
  .cart-head{gap:14rpx;padding-left:22rpx;padding-right:22rpx}
  .cart-search{width:320rpx}
  .premium-cart-item{grid-template-columns:38rpx 146rpx minmax(0,1fr);gap:14rpx;padding-left:24rpx;padding-right:24rpx}
  .cart-img{width:146rpx;height:146rpx}
  .checkout-btn{flex-basis:186rpx;width:186rpx}
}
