<view class="cart-page">
  <view class="cart-head">
    <view class="cart-title">购物车</view>
    <view class="cart-head-actions">
      <view class="cart-search">
        <text class="cart-search-icon">⌕</text>
        <input
          class="cart-search-input"
          value="{{searchKeyword}}"
          placeholder="搜索购物车商品"
          placeholder-class="cart-search-placeholder"
          confirm-type="search"
          bindinput="onCartSearchInput"
        />
        <text class="cart-search-clear" wx:if="{{searchKeyword}}" bindtap="clearCartSearch">×</text>
      </view>
      <button class="manage-btn {{items.length?'':'manage-btn--disabled'}}" bindtap="toggleManage" disabled="{{!items.length}}">{{managing?'完成':'管理'}}</button>
    </view>
  </view>

  <block wx:if="{{items.length}}">
    <view class="cart-select-row">
      <view class="select-all" bindtap="toggleAll">
        <view class="checkbox {{managing?(manageAllChecked?'checked':''):(allChecked?'checked':'')}}"></view>
        <text>全选</text>
      </view>
      <text class="cart-count-copy" wx:if="{{!managing}}">共 {{items.length}} 种 · 已选 {{selectedSkuCount}} 种</text>
      <text class="cart-count-copy" wx:else>已选 {{manageSelectedCount}} 种</text>
    </view>

    <view class="cart-list" wx:if="{{visibleItems.length}}">
      <view class="cart-item premium-cart-item" wx:for="{{visibleItems}}" wx:key="key">
        <view class="cart-check-wrap">
          <view class="checkbox {{managing?(item.manageChecked?'checked':''):(item.checked?'checked':'')}}" bindtap="toggleItem" data-key="{{item.key}}"></view>
        </view>
        <image class="cart-img" src="{{item.product.image}}" mode="aspectFill" bindtap="goProduct" data-id="{{item.product.id}}"></image>
        <view class="cart-content">
          <view class="cart-name" bindtap="goProduct" data-id="{{item.product.id}}">{{item.product.name}}</view>
          <view class="cart-meta">{{item.product.brand}} · {{item.spec}}</view>
          <view class="cart-maker">{{item.product.maker}}</view>
          <view class="cart-status-row">
            <text class="cart-stock" wx:if="{{item.product.stock>0}}">库存 {{item.product.stock}}{{item.product.unit}}</text>
            <text class="cart-stock cart-stock-warn" wx:else>库存需确认</text>
            <text class="cart-member-tag">{{item.product.moq}}{{item.product.unit}}起订</text>
          </view>
          <view class="cart-price-line">
            <text class="cart-price">¥{{item.product.price}}</text>
            <text class="cart-line-total">小计 ¥{{item.lineTotal}}</text>
          </view>
          <view class="cart-item-actions" wx:if="{{!managing}}">
            <button class="remove-btn" bindtap="remove" data-key="{{item.key}}">删除</button>
            <view class="quantity premium-quantity">
              <button class="qty-btn" bindtap="minus" data-key="{{item.key}}">−</button>
              <text class="qty-value">{{item.qty}}</text>
              <button class="qty-btn" bindtap="plus" data-key="{{item.key}}">＋</button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="cart-search-empty" wx:else>
      <text class="strong">未找到购物车中的商品</text>
      <text>换一个商品名、规格、品牌或厂家试试。</text>
      <button class="btn-text cart-search-reset" bindtap="clearCartSearch">清除搜索</button>
    </view>

    <view class="cart-summary" wx:if="{{!managing && !searchKeyword}}">
      <view class="summary-line"><text>商品金额</text><text>¥{{amount}}</text></view>
      <view class="summary-line total"><text>预计合计</text><text>¥{{total}}</text></view>
      <view class="summary-help">运费、活动政策、发票与最终供货条件将在结算时统一校验。</view>
    </view>
  </block>

  <view wx:else class="empty-state premium-empty cart-empty-under-head">
    <text class="strong">购物车暂无商品</text>
    <text>去分类挑选需要采购的商品。</text>
    <button class="btn-primary empty-button" bindtap="goCategory">去分类选品</button>
  </view>

  <view class="recommend-section" wx:if="{{recommendations.length && !managing && !searchKeyword}}">
    <view class="recommend-head">
      <view>
        <view class="recommend-title">相关采购推荐</view>
        <view class="recommend-sub" wx:if="{{items.length}}">根据购物车商品的场景、品类与采购关联度排序</view>
        <view class="recommend-sub" wx:else>购物车为空时优先展示高频可采购商品</view>
      </view>
      <text class="recommend-all" bindtap="goCategory">全部商品</text>
    </view>

    <view class="recommend-grid">
      <view class="recommend-card" wx:for="{{recommendations}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
        <view class="recommend-image-wrap">
          <image class="recommend-image" src="{{item.image}}" mode="aspectFill"></image>
          <text class="recommend-reason">{{item.recommendReason}}</text>
        </view>
        <view class="recommend-name">{{item.name}}</view>
        <view class="recommend-meta">{{item.brand}} · {{item.spec}}</view>
        <view class="recommend-maker">{{item.maker}}</view>
        <view class="recommend-stock">{{item.stock>0?'库存 '+item.stock+item.unit:'库存需确认'}} · {{item.moq}}{{item.unit}}起订</view>
        <view class="recommend-bottom">
          <view>
            <view class="recommend-price">¥{{item.price}}</view>
            <view class="recommend-price-label">采购价</view>
          </view>
          <button class="recommend-add" catchtap="addRecommended" data-id="{{item.id}}">加入购物车</button>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-space {{items.length?'bottom-space--footer':''}}"></view>

  <view class="cart-footer premium-cart-footer" wx:if="{{items.length && !managing}}">
    <view class="footer-select" bindtap="toggleAll"><view class="checkbox {{allChecked?'checked':''}}"></view><text>全选</text></view>
    <view class="footer-total"><text class="footer-label">合计</text><text class="footer-price">¥{{total}}</text><text class="footer-meta">已选 {{selectedCount}} 件</text></view>
    <button class="btn-primary checkout-btn" bindtap="checkout" disabled="{{selectedCount===0}}">去结算</button>
  </view>

  <view class="cart-footer manage-footer" wx:if="{{items.length && managing}}">
    <view class="footer-select" bindtap="toggleAll"><view class="checkbox {{manageAllChecked?'checked':''}}"></view><text>全选</text></view>
    <view class="manage-actions">
      <button class="manage-secondary" bindtap="addSelectedToFrequent" disabled="{{manageSelectedCount===0}}">加入常购</button>
      <button class="manage-danger" bindtap="deleteSelected" disabled="{{manageSelectedCount===0}}">删除{{manageSelectedCount?'('+manageSelectedCount+')':''}}</button>
    </view>
  </view>
</view>
