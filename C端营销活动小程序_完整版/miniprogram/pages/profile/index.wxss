.profile-head{align-items:flex-start}.profile-head>view:nth-child(2){min-width:0}.profile-head .h3{min-width:0;line-height:1.4;overflow-wrap:anywhere}.profile-head .caption{line-height:1.5;margin-top:6rpx;overflow-wrap:anywhere}.section-head>view{min-width:0}.member-quick{grid-template-columns:repeat(4,minmax(0,1fr))}.member-quick-item{min-width:0;padding-left:6rpx;padding-right:6rpx}.member-quick-item .strong,.member-quick-item text{white-space:nowrap}.menu-row{gap:20rpx}.menu-row>text:first-child{min-width:0}.menu-row>text:last-child{flex:none}
