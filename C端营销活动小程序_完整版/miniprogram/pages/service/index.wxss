.service-page{min-height:100vh;background:var(--bg);padding:48rpx 32rpx 72rpx}
.service-head{padding-top:8rpx}
.eyebrow{font-size:18rpx;color:#8F7861;letter-spacing:3rpx;font-weight:600}
.service-title{font-size:40rpx;line-height:1.25;font-weight:650;color:var(--text);margin-top:12rpx}
.service-desc{font-size:24rpx;line-height:1.7;color:#756E69;margin-top:12rpx;max-width:620rpx;overflow-wrap:anywhere}
.service-chat{margin-top:42rpx;background:#fff;border:1rpx solid var(--border);border-radius:var(--radius-md);padding:32rpx;display:grid;grid-template-columns:72rpx minmax(0,1fr);gap:20rpx;align-items:center}
.chat-icon{width:72rpx;height:72rpx;border-radius:50%;background:#EEE9E3;color:var(--brand);font-size:24rpx;font-weight:600;display:flex;align-items:center;justify-content:center}
.chat-copy{min-width:0}
.chat-title{font-size:29rpx;font-weight:650;color:#2A2724}
.chat-sub{font-size:22rpx;line-height:1.6;color:#7B746E;margin-top:6rpx;overflow-wrap:anywhere}
.chat-button{grid-column:1/3;width:100%;height:78rpx;margin-top:14rpx;border-radius:var(--radius-sm);background:var(--brand);color:#fff;font-size:25rpx;font-weight:600;display:flex;align-items:center;justify-content:center;border:0}
