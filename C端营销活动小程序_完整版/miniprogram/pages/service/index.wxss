.service-page{min-height:100vh;background:#f7f4ef;padding:48rpx 32rpx 72rpx;box-sizing:border-box}.service-head{padding-top:8rpx}.eyebrow{font-size:18rpx;color:#8f7861;letter-spacing:3rpx;font-weight:600}.service-title{font-size:40rpx;line-height:1.25;font-weight:650;color:#252220;margin-top:12rpx}.service-desc{font-size:24rpx;line-height:1.7;color:#756e69;margin-top:12rpx;max-width:620rpx}.service-chat{margin-top:42rpx;background:#fff;border:1rpx solid #e4ded7;padding:32rpx;display:grid;grid-template-columns:72rpx 1fr;gap:20rpx;align-items:center}.chat-icon{width:72rpx;height:72rpx;border-radius:50%;background:#eee9e3;color:#5e4b43;font-size:24rpx;font-weight:600;display:flex;align-items:center;justify-content:center}.chat-copy{min-width:0}.chat-title{font-size:29rpx;font-weight:650;color:#2a2724}.chat-sub{font-size:22rpx;line-height:1.6;color:#7b746e;margin-top:6rpx}.chat-button{grid-column:1/3;width:100%;height:78rpx;margin-top:14rpx;border-radius:4rpx;background:#5e4b43;color:#fff;font-size:25rpx;font-weight:600;display:flex;align-items:center;justify-content:center}.chat-button::after{border:0}
