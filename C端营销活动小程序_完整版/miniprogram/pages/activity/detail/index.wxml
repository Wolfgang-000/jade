
<view class="page">
  <view class="hero"><view class="eyebrow">{{activity.eyebrow}}</view><view class="title">{{activity.name}}</view><view class="sub">{{activity.subtitle}}</view><view class="date">{{activity.start}} — {{activity.end}}</view><button class="hero-btn" bindtap="openMall">查看会员精选</button></view>
  <view class="section"><view class="section-title">本期会员权益</view><view class="coupons"><view><text class="num">¥5</text><text>满59可用</text></view><view><text class="num">¥10</text><text>满99可用</text></view></view></view>
  <view class="section"><view class="section-title">本期主推</view></view>
  <view class="hero-product"><view class="pic"><image wx:if="{{hero.image}}" src="{{hero.image}}" mode="aspectFill"/><text wx:else>商品主图</text></view><view class="tag">{{hero.tag}}</view><view class="pname">{{hero.name}}</view><view class="spec">{{hero.spec}}</view><view class="sell">{{hero.sell}}</view><view class="price"><text>¥{{hero.activityPrice}}</text><text>¥{{hero.dailyPrice}}</text></view><button bindtap="buyHero">立即购买</button></view>
  <view class="section"><view class="section-title">更多会员精选</view><view class="grid"><product-card wx:for="{{rest}}" wx:key="id" product="{{item}}" bind:buy="buy"/></view></view>
  <view class="trust"><view><text>正品保障</text><text>合规商品展示</text></view><view><text>客服支持</text><text>购买问题响应</text></view><view><text>商城成交</text><text>订单回原商城</text></view></view>
  <view class="section"><view class="section-title">活动规则</view><view class="rules">活动时间、商品与实际价格以商城页面为准。点击“立即购买”后跳转到现有C端商城完成交易。</view><view class="service-link" bindtap="openService">需要帮助？联系客服 →</view></view>
  <view class="sticky safe-bottom"><button bindtap="openMall">进入商城查看更多商品</button></view>
</view>
