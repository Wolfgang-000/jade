.activity-overlay .h1{margin-top:12rpx;overflow-wrap:anywhere}
.activity-overlay>view:last-child{overflow-wrap:anywhere}
.editorial-main,.editorial-tile{min-width:0}
.editorial-copy .h3,.editorial-tile .h3{overflow-wrap:anywhere}
.product-card .price-small,.product-card .caption{max-width:100%;overflow:hidden;text-overflow:ellipsis}
.product-card .price-small{white-space:nowrap}
.product-card .caption{margin-top:6rpx;line-height:1.45;overflow-wrap:anywhere}
