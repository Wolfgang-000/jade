
.hero{padding:72rpx 32rpx 52rpx;background:#fff;border-bottom:1rpx solid #ebe6e0}.eyebrow{font-size:20rpx;color:#9b1c1f;font-weight:700;letter-spacing:3rpx}.title{font-size:58rpx;line-height:1.14;font-weight:650;margin-top:18rpx;overflow-wrap:anywhere}.sub{font-size:27rpx;color:#756d68;margin-top:18rpx;line-height:1.7}.date{font-size:22rpx;color:#9a918b;margin-top:16rpx}.hero-btn{margin:32rpx 0 0;min-height:84rpx;padding:0 22rpx;background:#9b1c1f;color:#fff;border-radius:10rpx;font-size:27rpx;font-weight:600;display:flex;align-items:center;justify-content:center;text-align:center;line-height:1.35}.hero-btn::after{border:0}.coupons{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.coupons>view{min-width:0;background:#fff;border:1rpx solid #eadfce;border-radius:14rpx;padding:24rpx}.coupons text{display:block;color:#796e66;font-size:22rpx;margin-top:5rpx;overflow-wrap:anywhere}.coupons .num{font-size:42rpx;color:#a9874e;font-weight:700;margin:0;white-space:nowrap}.hero-product{background:#fff;border-top:1rpx solid #ebe6e0;border-bottom:1rpx solid #ebe6e0;padding:28rpx 32rpx}.hero-product .pic{height:370rpx;background:#f1ebe4;border-radius:14rpx;display:flex;align-items:center;justify-content:center;color:#aca29b;overflow:hidden}.hero-product .pic image{width:100%;height:100%}.tag{display:inline-block;margin-top:24rpx;padding:7rpx 12rpx;background:#f6eee0;color:#826331;border-radius:8rpx;font-size:21rpx}.pname{font-size:36rpx;font-weight:650;margin-top:14rpx;overflow-wrap:anywhere}.spec{font-size:23rpx;color:#8d847e;margin-top:7rpx}.sell{font-size:25rpx;color:#69615c;line-height:1.7;margin-top:14rpx}.price{margin-top:18rpx;display:flex;align-items:baseline;gap:12rpx;flex-wrap:wrap}.price text:first-child{font-size:46rpx;color:#9b1c1f;font-weight:700;white-space:nowrap}.price text:last-child{font-size:22rpx;color:#aaa09a;text-decoration:line-through;margin-left:0;white-space:nowrap}.hero-product button{min-height:82rpx;padding:0 20rpx;background:#9b1c1f;color:#fff;border-radius:10rpx;font-size:26rpx;font-weight:600;margin-top:22rpx;display:flex;align-items:center;justify-content:center;line-height:1.35;text-align:center}.hero-product button::after{border:0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18rpx}.grid>view{min-width:0}.trust{margin-top:48rpx;background:#fff;border-top:1rpx solid #ebe6e0;border-bottom:1rpx solid #ebe6e0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));padding:30rpx 18rpx}.trust>view{min-width:0;text-align:center;padding:0 4rpx}.trust text{display:block}.trust text:first-child{font-size:24rpx;font-weight:600;white-space:nowrap}.trust text:last-child{font-size:19rpx;color:#8f8781;margin-top:5rpx;line-height:1.4;overflow-wrap:anywhere}.rules{font-size:24rpx;color:#746c66;line-height:1.8}.service-link{font-size:25rpx;font-weight:600;margin-top:24rpx}.sticky{position:sticky;bottom:0;padding:18rpx 24rpx;background:rgba(255,255,255,.96);border-top:1rpx solid #ebe6e0}.sticky button{min-height:88rpx;padding:0 22rpx;background:#9b1c1f;color:#fff;border-radius:12rpx;font-size:27rpx;font-weight:600;display:flex;align-items:center;justify-content:center;line-height:1.35;text-align:center}.sticky button::after{border:0}
