
.hero{padding:72rpx 32rpx 54rpx;background:#fff;border-bottom:1rpx solid #ebe6e0}.eyebrow{font-size:20rpx;color:#9b1c1f;font-weight:700;letter-spacing:3rpx}.brand-title{font-size:56rpx;font-weight:650;line-height:1.16;margin-top:18rpx}.lead{font-size:27rpx;color:#756e69;line-height:1.75;margin-top:18rpx}.container{padding:28rpx 32rpx 0}.main-event{background:#fff;border:1rpx solid #e7e0d8;padding:32rpx;border-radius:16rpx}.mini{font-size:21rpx;color:#9b1c1f;font-weight:600}.event-title{font-size:38rpx;font-weight:650;margin-top:16rpx}.event-benefit{font-size:46rpx;font-weight:650;color:#a9874e;margin-top:24rpx}.event-meta{font-size:22rpx;color:#958c86;margin-top:14rpx}.primary{height:82rpx;line-height:82rpx;background:#9b1c1f;color:#fff;border-radius:10rpx;font-size:27rpx;font-weight:600;margin-top:28rpx}.primary::after{border:0}.head{display:flex;justify-content:space-between;align-items:flex-end}.link{font-size:23rpx;color:#6f6762}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.quick{margin:48rpx 32rpx 0;border-top:1rpx solid #e9e3dd;border-bottom:1rpx solid #e9e3dd;display:grid;grid-template-columns:1fr 1fr;background:#fff}.quick>view{padding:28rpx}.quick>view:first-child{border-right:1rpx solid #e9e3dd}.quick text{display:block}.quick text:first-child{font-size:28rpx;font-weight:600}.quick text:last-child{font-size:22rpx;color:#8c837d;margin-top:6rpx}.sticky{position:sticky;bottom:0;padding:18rpx 24rpx;background:rgba(255,255,255,.96);border-top:1rpx solid #ebe6e0}.sticky button{height:88rpx;line-height:88rpx;background:#9b1c1f;color:#fff;border-radius:12rpx;font-size:27rpx;font-weight:600}.sticky button::after{border:0}
