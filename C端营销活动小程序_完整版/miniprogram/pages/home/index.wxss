.home-shell{background:var(--bg);min-height:100vh}
.home-top{padding:30rpx 32rpx 22rpx;background:var(--surface-soft)}
.brand-row{display:flex;align-items:center;justify-content:flex-start;min-width:0;margin-bottom:0}
.brand-word{font-size:36rpx;font-weight:650;letter-spacing:1rpx;white-space:nowrap;line-height:1.2}
.home-search{margin-top:22rpx;border-radius:var(--radius-md);background:#F0EDE8;border:1rpx solid #EBE6E0;min-width:0}
.home-search>text:last-child{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.search-icon{font-size:28rpx;color:#8C847E;flex:none}

.hero-swiper{height:570rpx;background:#E9E3DC}
.hero-slide{height:570rpx;position:relative;overflow:hidden}
.hero-slide image{width:100%;height:100%}
.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(20,16,13,.04) 20%,rgba(20,16,13,.58) 100%)}
.hero-copy{position:absolute;left:32rpx;right:32rpx;bottom:44rpx;color:#fff;min-width:0}
.hero-kicker{font-size:18rpx;letter-spacing:4rpx;font-weight:600;opacity:.88}
.hero-title{font-size:48rpx;line-height:1.18;font-weight:650;letter-spacing:-1rpx;margin-top:14rpx;overflow-wrap:anywhere}
.hero-sub{font-size:24rpx;line-height:1.65;opacity:.9;margin-top:12rpx;max-width:600rpx;overflow-wrap:anywhere}
.hero-link{display:inline-flex;align-items:center;margin-top:20rpx;padding-bottom:5rpx;border-bottom:1rpx solid rgba(255,255,255,.7);color:#fff;font-size:21rpx;font-weight:600}

.service-proof{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#fff;border-bottom:1rpx solid var(--border)}
.proof-item{min-width:0;padding:22rpx 10rpx;text-align:center;transition:background-color .16s ease}
.proof-item+.proof-item{border-left:1rpx solid var(--divider)}
.proof-item--interactive{position:relative}
.proof-item--pressed{background:#F3EFE9}
.proof-title{display:block;font-size:23rpx;font-weight:600;white-space:nowrap}
.proof-sub{display:block;font-size:18rpx;color:#8D857F;margin-top:4rpx;line-height:1.45;overflow-wrap:anywhere}
.proof-action{display:block;font-size:17rpx;color:#6D5945;margin-top:8rpx;white-space:nowrap}

.home-section{padding-top:52rpx}
.theme-recommend-section{padding-top:40rpx;background:var(--surface-soft);border-bottom:1rpx solid var(--border)}
.theme-section-head{align-items:flex-end}
.theme-section-head>view{min-width:0}
.theme-kicker{font-size:17rpx;line-height:1.2;letter-spacing:3rpx;color:#8C735A;font-weight:600;margin-bottom:10rpx}
.theme-count{font-size:18rpx;letter-spacing:2rpx;color:var(--text-3);white-space:nowrap;padding-bottom:5rpx;flex:none}
.theme-product-panel{margin-top:26rpx;border-top:1rpx solid var(--border);transition:opacity .2s ease,transform .2s ease;opacity:1;transform:translateY(0)}
.theme-product-panel--switching{opacity:.28;transform:translateY(6rpx)}
.theme-product-list{background:var(--surface-soft)}
.theme-product-row{display:grid;grid-template-columns:132rpx minmax(0,1fr);gap:22rpx;padding:24rpx 0;border-bottom:1rpx solid var(--divider)}
.theme-product-row:last-child{border-bottom:0}
.theme-product-image{width:132rpx;height:132rpx;background:#EEE9E3;border:1rpx solid #E4DED7}
.theme-product-content{min-width:0;display:flex;flex-direction:column}
.theme-product-name{font-size:27rpx;line-height:1.35;font-weight:650;color:#292624;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-product-meta{font-size:18rpx;color:#7E7771;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-product-spec{font-size:19rpx;color:#8D857F;margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-product-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx;margin-top:auto;padding-top:12rpx;min-width:0}
.theme-product-bottom>view{min-width:0}
.theme-product-price{max-width:100%;font-size:23rpx;color:var(--brand);font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-product-stock{font-size:18rpx;color:#66786A;margin-top:4rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.theme-add{flex:none;min-width:92rpx;height:52rpx;padding:0 18rpx;border-radius:var(--radius-sm);border:1rpx solid #BFB5AB;background:#fff;color:#403B37;font-size:19rpx;white-space:nowrap;display:flex;align-items:center;justify-content:center}
.theme-empty{padding:48rpx 0 52rpx;display:flex;flex-direction:column;gap:10rpx;align-items:flex-start}

.premium-category-scroll{margin-top:2rpx}
.premium-category{width:188rpx;margin-right:16rpx}
.premium-category-visual{height:154rpx;background:#ECE8E2;border:1rpx solid #E7E2DC;font-size:22rpx;letter-spacing:2rpx}

.premium-scenes{grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx}
.premium-scene{min-width:0;min-height:220rpx;padding:22rpx;border:1rpx solid #E4DED7;background:#EEE9E3}
.premium-scene:nth-child(2n){background:#E9ECE8}
.scene-index{font-size:18rpx;color:#9B928B;letter-spacing:2rpx;margin-bottom:auto}

@media (max-width:360px){
  .hero-title{font-size:44rpx}
  .proof-title{font-size:22rpx}
  .proof-sub{font-size:17rpx}
  .theme-product-row{grid-template-columns:122rpx minmax(0,1fr);gap:18rpx}
  .theme-product-image{width:122rpx;height:122rpx}
}
