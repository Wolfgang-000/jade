<view class="home-shell">
  <view class="home-top">
    <view class="brand-row">
      <view class="brand-word">澄和健康</view>
    </view>
    <view class="search-bar home-search" bindtap="goSearch">
      <text class="search-icon">⌕</text>
      <text>搜索商品、通用名、厂家或批准文号</text>
    </view>
  </view>

  <swiper class="hero-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#ffffff" autoplay interval="5200" circular bindchange="onBannerChange">
    <swiper-item wx:for="{{activities}}" wx:key="id">
      <view class="hero-slide">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <view class="hero-kicker">B2B PROCUREMENT</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-sub">{{item.subtitle}}</view>
          <view class="hero-link">{{item.cta}} ↓</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="service-proof">
    <view class="proof-item proof-item--interactive" bindtap="showChannelInfo" hover-class="proof-item--pressed">
      <text class="proof-title">正规渠道</text>
      <text class="proof-sub">商品与资质信息可查</text>
      <text class="proof-action">查看说明 ›</text>
    </view>
    <view class="proof-item proof-item--interactive" bindtap="showFulfillmentInfo" hover-class="proof-item--pressed">
      <text class="proof-title">库存履约</text>
      <text class="proof-sub">库存、批号、效期确认</text>
      <text class="proof-action">查看说明 ›</text>
    </view>
    <view class="proof-item proof-item--interactive" bindtap="goService" hover-class="proof-item--pressed">
      <text class="proof-title">客服咨询</text>
      <text class="proof-sub">采购与订单问题</text>
      <text class="proof-action">立即咨询 ›</text>
    </view>
  </view>

  <view class="section home-section theme-recommend-section">
    <view class="section-head theme-section-head">
      <view>
        <view class="theme-kicker">CURRENT THEME · 0{{activeBannerIndex+1}}</view>
        <view class="section-title">{{activeActivity.recommendationTitle}}</view>
        <view class="section-sub">{{activeActivity.recommendationSubtitle}}</view>
      </view>
      <text class="theme-count">0{{activeBannerIndex+1}} / 0{{activities.length}}</text>
    </view>

    <view class="theme-product-panel {{themeSwitching?'theme-product-panel--switching':''}}">
      <view wx:if="{{themeProducts.length}}" class="theme-product-list">
        <view class="theme-product-row" wx:for="{{themeProducts}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
          <image class="theme-product-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="theme-product-content">
            <view class="theme-product-name">{{item.name}}</view>
            <view class="theme-product-meta">{{item.brand}} · {{item.maker}}</view>
            <view class="theme-product-spec">{{item.spec}} · {{item.moq}}{{item.unit}}起订</view>
            <view class="theme-product-bottom">
              <view>
                <view class="theme-product-price">采购价 ¥{{item.price}}</view>
                <view class="theme-product-stock">{{item.stock>0?'库存 '+item.stock+item.unit:'库存需确认'}}</view>
              </view>
              <button class="theme-add" catchtap="quickAdd" data-id="{{item.id}}">加入</button>
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="theme-empty">
        <text class="strong">当前暂无该主题可采购商品</text>
        <text class="section-sub">可查看全部商品继续采购。</text>
        <text class="link" bindtap="goAllProducts">查看全部商品 →</text>
      </view>
    </view>
  </view>

  <view class="section home-section">
    <view class="section-head">
      <view>
        <view class="section-title">快捷采购</view>
        <view class="section-sub">按经营品类快速找货与采购</view>
      </view>
      <text class="link" bindtap="goCategory">全部分类</text>
    </view>
    <scroll-view class="category-scroll premium-category-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="category-item premium-category" wx:for="{{categories}}" wx:key="id" bindtap="goCategory">
        <view class="category-visual premium-category-visual">{{item.short}}</view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-desc">{{item.desc}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section home-section safe-bottom">
    <view class="section-head"><view><view class="section-title">采购专区</view><view class="section-sub">把高频采购任务集中到更短路径</view></view></view>
    <view class="scene-list premium-scenes">
      <view class="scene premium-scene" wx:for="{{scenes}}" wx:key="id" bindtap="goZone" data-id="{{item.id}}">
        <view class="scene-index">0{{index+1}}</view>
        <view class="scene-title">{{item.title}}</view>
        <view class="scene-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>
