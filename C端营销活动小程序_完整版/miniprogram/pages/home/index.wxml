<view class="home-shell">
  <view class="home-top">
    <view class="brand-row">
      <view class="brand-word">澄和健康</view>
    </view>
    <view class="search-bar home-search" bindtap="goSearch">
      <text class="search-icon">⌕</text>
      <text>搜索商品、通用名、厂家或批准文号</text>
    </view>
  </view>

  <swiper class="hero-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.45)" indicator-active-color="#ffffff" autoplay interval="5200" circular>
    <swiper-item wx:for="{{activities}}" wx:key="id">
      <view class="hero-slide" bindtap="goActivity" data-id="{{item.id}}">
        <image src="{{item.image}}" mode="aspectFill"></image>
        <view class="hero-shade"></view>
        <view class="hero-copy">
          <view class="hero-kicker">B2B PROCUREMENT</view>
          <view class="hero-title">{{item.title}}</view>
          <view class="hero-sub">{{item.subtitle}}</view>
          <view class="hero-link">{{item.cta}} →</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="service-proof">
    <view class="proof-item"><text class="proof-title">正规渠道</text><text class="proof-sub">商品与资质信息可查</text></view>
    <view class="proof-item"><text class="proof-title">库存履约</text><text class="proof-sub">库存、批号、效期确认</text></view>
    <view class="proof-item" bindtap="goService"><text class="proof-title">客服咨询</text><text class="proof-sub">报价、物流与售后</text></view>
  </view>

  <view class="section home-section">
    <view class="section-head">
      <view>
        <view class="section-title">快捷采购</view>
        <view class="section-sub">按经营品类快速找货与采购</view>
      </view>
      <text class="link" bindtap="goCategory">全部分类</text>
    </view>
    <scroll-view class="category-scroll premium-category-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="category-item premium-category" wx:for="{{categories}}" wx:key="id" bindtap="goCategory">
        <view class="category-visual premium-category-visual">{{item.short}}</view>
        <view class="category-name">{{item.name}}</view>
        <view class="category-desc">{{item.desc}}</view>
      </view>
    </scroll-view>
  </view>

  <view class="section home-section service-entry-section">
    <view class="service-entry" bindtap="goService">
      <view>
        <view class="service-kicker">CUSTOMER SERVICE</view>
        <view class="service-title">需要报价、找货或订单协助？</view>
        <view class="service-desc">大单询价、缺货找货、订单物流、资质与售后问题统一由客服承接。</view>
      </view>
      <view class="service-arrow">→</view>
    </view>
  </view>

  <view class="section home-section">
    <view class="member-panel premium-member" bindtap="goProfile">
      <view class="member-topline">
        <view class="member-level">PROCUREMENT ACCOUNT · {{customer.level}}</view>
        <view class="member-link">采购账户 →</view>
      </view>
      <view class="member-title">{{customer.companyName}}</view>
      <view class="member-stats">
        <view class="member-stat"><text class="strong">{{customer.pendingShip}}</text><text>待发货</text></view>
        <view class="member-stat"><text class="strong">{{customer.pendingReceive}}</text><text>待收货</text></view>
        <view class="member-stat"><text class="strong">{{customer.frequentSku}}</text><text>常购品种</text></view>
      </view>
    </view>
  </view>

  <view class="section home-section">
    <view class="section-head">
      <view>
        <view class="section-title">重点品种</view>
        <view class="section-sub">结合季节、供应与采购需求做少量重点陈列</view>
      </view>
    </view>
    <view class="editorial-feature premium-editorial">
      <view class="editorial-main" bindtap="goProduct" data-id="{{products[0].id}}">
        <image src="{{products[0].image}}" mode="aspectFill"></image>
        <view class="editorial-copy">
          <view class="editorial-kicker">KEY SKU</view>
          <view class="editorial-name">{{products[0].name}}</view>
          <view class="editorial-meta">{{products[0].brand}} · {{products[0].spec}}</view>
          <view class="editorial-price">采购价 ¥{{products[0].price}} · {{products[0].moq}}{{products[0].unit}}起订</view>
        </view>
      </view>
      <view class="editorial-side">
        <view class="editorial-tile" bindtap="goProduct" data-id="{{products[3].id}}">
          <view class="editorial-kicker">SEASONAL</view>
          <view class="editorial-tile-name">{{products[3].name}}</view>
          <view class="caption">{{products[3].spec}} · {{products[3].moq}}{{products[3].unit}}起订</view>
          <view class="tile-link">查看采购条件 →</view>
        </view>
        <view class="editorial-tile editorial-tile-alt" bindtap="goProduct" data-id="{{products[4].id}}">
          <view class="editorial-kicker">KEY SUPPLY</view>
          <view class="editorial-tile-name">{{products[4].name}}</view>
          <view class="caption">采购价 ¥{{products[4].price}}</view>
          <view class="tile-link">查看采购条件 →</view>
        </view>
      </view>
    </view>
  </view>

  <view class="section home-section">
    <view class="section-head">
      <view>
        <view class="section-title">采购推荐</view>
        <view class="section-sub">优先展示采购价、起订量、库存与规格</view>
      </view>
    </view>
    <view class="product-grid premium-product-grid">
      <view class="product-card premium-product-card" wx:for="{{products}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
        <view class="product-card__image premium-product-image">
          <image src="{{item.image}}" mode="aspectFill"></image>
          <view class="product-card__badge">{{item.otc}}</view>
        </view>
        <view class="product-card__name">{{item.name}}</view>
        <view class="product-card__meta">{{item.brand}} · {{item.spec}}</view>
        <view class="stock-line">{{item.stock>0?'库存 '+item.stock+item.unit:'库存需确认'}}</view>
        <view class="product-card__price">
          <view>
            <text class="price-small">采购价 ¥{{item.price}}</text>
            <view class="member-price">{{item.moq}}{{item.unit}}起订 · {{item.taxInclusive?'含税':'税费另计'}}</view>
          </view>
          <button class="quick-bag" catchtap="quickAdd" data-id="{{item.id}}">＋</button>
        </view>
      </view>
    </view>
  </view>

  <view class="section home-section safe-bottom">
    <view class="section-head"><view><view class="section-title">采购专区</view><view class="section-sub">把高频采购任务集中到更短路径</view></view></view>
    <view class="scene-list premium-scenes">
      <view class="scene premium-scene" wx:for="{{scenes}}" wx:key="id" bindtap="goZone" data-id="{{item.id}}">
        <view class="scene-index">0{{index+1}}</view>
        <view class="scene-title">{{item.title}}</view>
        <view class="scene-desc">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>
