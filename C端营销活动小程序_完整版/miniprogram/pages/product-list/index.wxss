.filter-bar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:0;padding:0 20rpx}.filter-item{text-align:center;white-space:nowrap}.product-row{grid-template-columns:190rpx minmax(0,1fr);gap:20rpx}.product-row__img{height:190rpx}.product-row__content{min-width:0}.product-row__name{overflow-wrap:anywhere}.product-row__meta{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.product-row__tags{min-width:0}.product-row__bottom{min-width:0}.product-row__bottom .price-small,.member-price{white-space:nowrap}
