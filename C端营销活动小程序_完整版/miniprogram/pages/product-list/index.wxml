<view class="surface" style="padding:28rpx 32rpx 18rpx">
  <view class="h2">{{category}}</view>
  <view class="section-sub">优先展示规格、采购价、起订量、库存与资质属性</view>
</view>
<view class="filter-bar">
  <text class="filter-item {{sort==='综合'?'active':''}}" data-sort="综合" bindtap="setSort">综合</text>
  <text class="filter-item" data-sort="销量" bindtap="setSort">动销</text>
  <text class="filter-item" data-sort="新品" bindtap="setSort">新品</text>
  <text class="filter-item" data-sort="价格" bindtap="setSort">采购价</text>
</view>
<view class="product-list">
  <view class="product-row" wx:for="{{list}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
    <image class="product-row__img" src="{{item.image}}" mode="aspectFill"></image>
    <view class="product-row__content">
      <view class="product-row__name">{{item.name}}</view>
      <view class="product-row__meta">{{item.brand}} · {{item.spec}}</view>
      <view class="product-row__tags"><text class="tag">{{item.otc}}</text><text class="tag tag-brand">{{item.moq}}{{item.unit}}起订</text></view>
      <view class="product-row__bottom"><text class="price-small">采购价 ¥{{item.price}}</text><view class="member-price">库存 {{item.stock}}{{item.unit}}</view></view>
    </view>
  </view>
</view>
