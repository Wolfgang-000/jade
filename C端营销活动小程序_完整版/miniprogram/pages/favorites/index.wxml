<view wx:if="{{list.length}}" class="product-list">
  <view class="product-row" wx:for="{{list}}" wx:key="id" bindtap="go" data-id="{{item.id}}">
    <image class="product-row__img" src="{{item.image}}" mode="aspectFill"></image>
    <view class="product-row__content">
      <view class="product-row__name">{{item.name}}</view>
      <view class="product-row__meta">{{item.brand}} · {{item.spec}}</view>
      <view class="product-row__tags"><text class="tag">{{item.moq}}{{item.unit}}起订</text><text class="tag tag-brand">库存 {{item.stock}}{{item.unit}}</text></view>
      <view class="product-row__bottom"><text class="price-small">采购价 ¥{{item.price}}</text><button class="btn-secondary" style="height:60rpx;margin-top:12rpx" catchtap="cart" data-id="{{item.id}}">加入采购单</button></view>
    </view>
  </view>
</view>
<view wx:else class="empty-state"><text class="strong">暂无常购商品</text><text>把高频采购商品加入常购，后续采购时可以更快找到。</text></view>
