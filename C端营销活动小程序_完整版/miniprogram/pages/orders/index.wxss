.order-tabs{white-space:nowrap;padding:20rpx 24rpx;border-bottom:1rpx solid var(--border)}.order-tabs .chip{display:inline-flex;margin-right:12rpx;white-space:nowrap}.orders-page{padding-top:16rpx}.order-card{overflow:hidden}.order-head{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.order-id{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.order-status{flex:none;white-space:nowrap}.order-product{grid-template-columns:150rpx minmax(0,1fr);align-items:center}.order-product-copy{min-width:0}.order-product-name{min-width:0;line-height:1.45;overflow-wrap:anywhere}.order-product-meta{margin-top:6rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.order-amount{margin-top:14rpx;white-space:nowrap}.order-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12rpx}.order-action-btn{width:100%;min-width:0;height:68rpx;min-height:68rpx;padding:0 16rpx;font-size:23rpx;white-space:nowrap}
