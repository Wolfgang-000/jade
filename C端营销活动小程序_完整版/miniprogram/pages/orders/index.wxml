<scroll-view scroll-x class="surface order-tabs">
  <text class="chip {{active===item?'active':''}}" wx:for="{{tabs}}" wx:key="*this" bindtap="tab" data-t="{{item}}">{{item}}</text>
</scroll-view>
<view class="orders-page">
  <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="detail" data-id="{{item.id}}">
    <view class="order-head">
      <text class="caption order-id">订单 {{item.id}}</text>
      <text class="order-status">{{item.status}}</text>
    </view>
    <view class="order-product">
      <image class="order-img" src="{{item.product.image}}" mode="aspectFill"></image>
      <view class="order-product-copy">
        <view class="row-title order-product-name">{{item.product.name}}</view>
        <view class="caption order-product-meta">{{item.product.spec}} × {{item.qty}}{{item.product.unit}}</view>
        <view class="price-small order-amount">¥{{item.amount}}</view>
      </view>
    </view>
    <view class="order-actions">
      <button class="btn-secondary order-action-btn" catchtap="rebuy" data-id="{{item.id}}">再次采购</button>
      <button class="btn-primary order-action-btn">查看订单</button>
    </view>
  </view>
</view>
