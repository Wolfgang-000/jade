<view class="home-top"><view class="search-bar" bindtap="goSearch"><text>⌕</text><text>搜索商品、通用名、品牌</text></view></view>
<view class="category-page">
  <scroll-view class="category-left" scroll-y>
    <view class="category-left-item {{active===index?'active':''}}" wx:for="{{categories}}" wx:key="id" data-i="{{index}}" bindtap="choose">{{item.name}}</view>
  </scroll-view>
  <scroll-view class="category-right" scroll-y>
    <view class="subcat-title">{{categories[active].name}}</view>
    <view class="section-sub" style="margin-bottom:22rpx">{{categories[active].desc}}</view>
    <view class="subcat-grid">
      <view class="subcat-item" wx:for="{{categories[active].subs}}" wx:key="*this" bindtap="goList" data-name="{{item}}">
        <text class="strong">{{item}}</text><text>查看精选商品 →</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="h3">筛选维度</view>
    <view class="chip-row" style="margin-top:18rpx"><text class="chip">品牌</text><text class="chip">价格</text><text class="chip">剂型</text><text class="chip">规格</text><text class="chip">适用人群</text><text class="chip">OTC属性</text></view>
  </scroll-view>
</view>