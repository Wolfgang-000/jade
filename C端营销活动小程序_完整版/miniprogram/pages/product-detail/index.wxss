.pdp-page{background:#f7f4ef}.pdp-gallery-wrap{position:relative;background:#ece7e0}.pdp-gallery{height:720rpx}.pdp-gallery image{width:100%;height:100%}.gallery-count{position:absolute;right:24rpx;bottom:20rpx;min-width:72rpx;height:42rpx;padding:0 12rpx;border-radius:999rpx;background:rgba(35,31,28,.65);color:#fff;font-size:20rpx;display:flex;align-items:center;justify-content:center}.premium-pdp-main{padding-top:32rpx}.price-zone{margin-top:26rpx;padding-top:24rpx;border-top:1rpx solid #ece6df}.price-line{display:flex;align-items:baseline;gap:8rpx}.member-benefit-line{margin-top:14rpx;padding:18rpx 20rpx;background:#f4efe9;display:flex;align-items:center;gap:12rpx;font-size:22rpx;color:#6d5945}.member-mark{font-size:17rpx;letter-spacing:2rpx;color:#8e765d;font-weight:600}.member-benefit-link{margin-left:auto;color:#5e4b43}.rx-notice{margin-top:24rpx;padding:22rpx;background:#fbf3e8;border-left:4rpx solid #a18463}.rx-title{font-size:25rpx;font-weight:650;color:#6d5438}.rx-copy{font-size:22rpx;line-height:1.65;color:#766a5d;margin-top:8rpx}.purchase-block{padding-top:10rpx;padding-bottom:10rpx}.purchase-row{display:grid;grid-template-columns:112rpx 1fr;gap:16rpx;align-items:flex-start;padding:22rpx 0;border-bottom:1rpx solid #ece6df}.purchase-row:last-child{border-bottom:0}.purchase-label{font-size:23rpx;color:#918983}.purchase-value{display:flex;align-items:center;justify-content:space-between;gap:14rpx;font-size:24rpx}.purchase-sub{display:block;font-size:20rpx;color:#9a938d;margin-left:auto;text-align:right}.purchase-arrow{font-size:34rpx;color:#8a817a;line-height:1}.stock-ok{color:#52705d}.stock-low{color:#966728}.stock-warn{color:#a3443b}.pharmacist-entry{display:grid;grid-template-columns:1fr 64rpx;gap:20rpx;align-items:center;background:#2c2926;color:#f8f5f1}.service-kicker{font-size:17rpx;letter-spacing:3rpx;color:#d7c29e;font-weight:600}.service-title{font-size:30rpx;font-weight:650;margin-top:8rpx}.service-copy{font-size:21rpx;line-height:1.65;color:#c5bdb6;margin-top:8rpx}.service-arrow{width:58rpx;height:58rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:50%;display:flex;align-items:center;justify-content:center}.pdp-section-head{margin-bottom:10rpx}.pdp-section-title{font-size:31rpx;font-weight:650}.pdp-section-sub{font-size:21rpx;color:#98908a;margin-top:6rpx}.info-link{margin-top:20rpx;height:72rpx;padding:0 2rpx;color:#5e4b43;font-size:23rpx;display:flex;align-items:center;justify-content:flex-start;background:transparent}.info-link::after{border:0}.content-lead{font-size:24rpx;line-height:1.8;color:#6f6964;margin-top:14rpx}.content-image{width:100%;margin-top:24rpx;display:block}.trust-block{padding-top:22rpx;padding-bottom:22rpx}.premium-pdp-bottom{grid-template-columns:86rpx 86rpx 86rpx minmax(150rpx,1fr) minmax(150rpx,1fr);gap:8rpx;padding-left:14rpx;padding-right:14rpx}.pdp-icon{position:relative}.icon-text{font-size:27rpx;color:#312d2a}.mini-badge{position:absolute;top:2rpx;right:4rpx;min-width:26rpx;height:26rpx;padding:0 5rpx;border-radius:999rpx;background:#5e4b43;color:#fff;font-size:16rpx;display:flex;align-items:center;justify-content:center}.pdp-cart-btn,.pdp-buy-btn{padding-left:14rpx;padding-right:14rpx;font-size:24rpx}.pdp-spacer{height:132rpx}
