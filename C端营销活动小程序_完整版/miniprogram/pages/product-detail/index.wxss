.pdp-page{
  min-height:100vh;
  background:var(--bg);
  padding-bottom:calc(124rpx + env(safe-area-inset-bottom));
}
.pdp-gallery-wrap{position:relative;background:#ECE7E0}
.pdp-gallery{height:720rpx}
.pdp-gallery image{width:100%;height:100%}
.gallery-count{position:absolute;right:24rpx;bottom:20rpx;min-width:72rpx;height:42rpx;padding:0 12rpx;border-radius:999rpx;background:rgba(35,31,28,.65);color:#fff;font-size:20rpx;display:flex;align-items:center;justify-content:center}

.premium-pdp-main{padding-top:32rpx}
.price-zone{margin-top:24rpx;padding-top:22rpx;border-top:1rpx solid var(--divider)}
.price-line{display:flex;align-items:baseline;gap:12rpx;min-width:0;min-height:52rpx}
.purchase-price-label{font-size:26rpx;line-height:1.2;font-weight:600;color:#312D2A;white-space:nowrap;flex:none}
.purchase-price-value{min-width:0;max-width:100%;font-size:38rpx;line-height:1.15;font-weight:700;letter-spacing:-1rpx;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rx-notice{margin-top:24rpx;padding:22rpx;background:#FBF3E8;border-left:4rpx solid var(--brand-2)}
.rx-title{font-size:25rpx;font-weight:650;color:#6D5438}
.rx-copy{font-size:22rpx;line-height:1.65;color:#766A5D;margin-top:8rpx}

.purchase-block{padding-top:10rpx;padding-bottom:10rpx}
.purchase-row{display:grid;grid-template-columns:112rpx minmax(0,1fr);gap:16rpx;align-items:start;padding:22rpx 0;border-bottom:1rpx solid var(--divider)}
.purchase-row:last-child{border-bottom:0}
.purchase-label{font-size:23rpx;color:#918983;padding-top:1rpx;white-space:nowrap}
.purchase-value{min-width:0;display:grid;grid-template-columns:minmax(0,1fr);row-gap:5rpx;font-size:24rpx}
.purchase-main{min-width:0;line-height:1.45;overflow-wrap:anywhere}
.purchase-sub{font-size:19rpx;color:var(--text-3);line-height:1.45;text-align:left;overflow-wrap:anywhere}
.stock-ok{color:#52705D}
.stock-low{color:#966728}
.stock-warn{color:var(--danger)}

.variant-block{padding-top:28rpx;padding-bottom:18rpx}
.pdp-section-head{margin-bottom:10rpx}
.pdp-section-head>view{min-width:0}
.pdp-section-title{font-size:31rpx;font-weight:650;line-height:1.35}
.pdp-section-sub{font-size:21rpx;color:#98908A;margin-top:6rpx;line-height:1.55;overflow-wrap:anywhere}
.variant-list{border-top:1rpx solid var(--divider)}
.variant-card{display:grid;grid-template-columns:104rpx minmax(0,1fr) auto 24rpx;gap:16rpx;align-items:center;padding:20rpx 0;border-bottom:1rpx solid var(--divider)}
.variant-card:last-child{border-bottom:0}
.variant-image{width:104rpx;height:104rpx;background:#EEE9E3}
.variant-copy{min-width:0}
.variant-name{font-size:25rpx;font-weight:650;line-height:1.4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.variant-spec,.variant-meta{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.variant-spec{font-size:20rpx;color:var(--text-2);margin-top:5rpx}
.variant-meta{font-size:18rpx;color:#92908A;margin-top:5rpx}
.variant-price{max-width:170rpx;font-size:25rpx;font-weight:700;color:#4F443D;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.variant-arrow{font-size:30rpx;color:#A29A94;line-height:1}

.customer-service-entry{display:grid;grid-template-columns:minmax(0,1fr) 64rpx;gap:20rpx;align-items:center;background:#2C2926;color:#F8F5F1;padding-top:26rpx;padding-bottom:26rpx}
.customer-service-entry>view:first-child{min-width:0}
.service-kicker{font-size:17rpx;letter-spacing:3rpx;color:#D7C29E;font-weight:600}
.service-title{font-size:29rpx;font-weight:650;margin-top:7rpx;line-height:1.35}
.service-copy{font-size:20rpx;line-height:1.55;color:#C5BDB6;margin-top:7rpx;overflow-wrap:anywhere}
.service-arrow{width:58rpx;height:58rpx;border:1rpx solid rgba(255,255,255,.25);border-radius:50%;display:flex;align-items:center;justify-content:center;flex:none}

.pdp-row{grid-template-columns:132rpx minmax(0,1fr)}
.pdp-row>text:last-child{min-width:0;overflow-wrap:anywhere}
.instruction-block{padding-top:30rpx;padding-bottom:18rpx}
.instruction-head{padding-bottom:10rpx}
.instruction-row{display:grid;grid-template-columns:152rpx minmax(0,1fr);gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid var(--divider)}
.instruction-row:last-of-type{border-bottom:0}
.instruction-label{font-size:21rpx;color:#8E8781;line-height:1.6}
.instruction-value{min-width:0;font-size:23rpx;color:#403B37;line-height:1.65;overflow-wrap:anywhere}
.instruction-link{margin-top:18rpx}
.info-link{margin-top:20rpx;min-height:72rpx;height:auto;padding:14rpx 0;color:var(--brand);font-size:23rpx;line-height:1.45;display:flex;align-items:center;justify-content:flex-start;background:transparent;text-align:left;border:0;border-radius:0}
.content-lead{font-size:24rpx;line-height:1.8;color:var(--text-2);margin-top:14rpx;overflow-wrap:anywhere}

.trust-block{padding-top:22rpx;padding-bottom:22rpx}
.trust-row{grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx}
.trust-item{min-width:0;padding:0 4rpx}
.trust-item .strong{white-space:nowrap}
.trust-item text:last-child{display:block;line-height:1.45;overflow-wrap:anywhere}

.pdp-action-bar{position:fixed;left:0;right:0;bottom:0;z-index:30;background:#FFF;border-top:1rpx solid var(--border);padding:12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom))}
.pdp-action-inner{display:flex;align-items:stretch;gap:12rpx;min-width:0}
.pdp-aux-actions{flex:0 0 204rpx;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));min-width:0}
.pdp-aux-btn{position:relative;min-width:0;height:80rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3rpx;background:transparent;color:var(--text-2);font-size:17rpx;border:0;border-radius:0;white-space:nowrap}
.pdp-aux-btn+.pdp-aux-btn{border-left:1rpx solid var(--divider)}
.pdp-aux-icon-wrap{position:relative;display:flex;align-items:center;justify-content:center;min-width:30rpx}
.pdp-aux-icon{font-size:24rpx;line-height:1.1;color:#312D2A}
.mini-badge{position:absolute;top:-10rpx;right:-18rpx;min-width:24rpx;height:24rpx;padding:0 4rpx;border-radius:999rpx;background:var(--brand);color:#fff;font-size:15rpx;display:flex;align-items:center;justify-content:center}
.pdp-primary-actions{flex:1 1 auto;min-width:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10rpx}
.pdp-action-secondary,.pdp-action-primary{min-width:0;height:80rpx;padding:0 12rpx;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-md);font-size:22rpx;font-weight:650;white-space:nowrap;text-align:center}
.pdp-action-secondary{background:#FFF;color:#463F3A;border:1rpx solid var(--border-2)}
.pdp-action-primary{background:var(--brand);color:#FFF;border:0}

@media (max-width:360px){
  .pdp-aux-actions{flex-basis:186rpx}
  .pdp-action-inner{gap:10rpx}
  .pdp-primary-actions{gap:8rpx}
  .pdp-action-secondary,.pdp-action-primary{font-size:21rpx;padding:0 8rpx}
}
