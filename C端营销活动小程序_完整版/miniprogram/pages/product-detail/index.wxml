<view wx:if="{{product}}" class="pdp-page">
  <view class="pdp-gallery-wrap">
    <swiper class="pdp-gallery" indicator-dots="{{false}}" circular bindchange="galleryChange">
      <swiper-item wx:for="{{product.gallery}}" wx:key="*this">
        <image src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
    <view class="gallery-count">{{galleryIndex+1}} / {{product.gallery.length}}</view>
  </view>

  <view class="pdp-main premium-pdp-main">
    <view class="pdp-tags">
      <text class="tag">{{product.otc}}</text>
      <text class="tag tag-brand" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="pdp-name">{{product.name}}</view>
    <view class="pdp-generic">通用名称：{{product.generic}}</view>

    <view class="price-zone">
      <view class="price-line">
        <text class="purchase-price-label">采购价</text>
        <text class="purchase-price-value">¥{{product.price}}</text>
      </view>
      <view class="member-benefit-line">
        <text class="member-mark">B2B</text>
        <text>{{product.moq}}{{product.unit}}起订</text>
        <text class="member-benefit-link">{{product.taxInclusive?'含税价':'税费另计'}}</text>
      </view>
    </view>

    <view class="rx-notice" wx:if="{{product.regulatoryMode==='rx'}}">
      <view class="rx-title">采购资质要求</view>
      <view class="rx-copy">该商品仅面向具备相应经营资质和经营范围的B端客户展示与采购，正式系统需在下单前完成资质校验。</view>
    </view>
  </view>

  <view class="pdp-block purchase-block">
    <view class="purchase-row">
      <text class="purchase-label">规格</text>
      <view class="purchase-value">
        <text class="purchase-main">{{product.spec}}</text>
      </view>
    </view>
    <view class="purchase-row">
      <text class="purchase-label">起订</text>
      <view class="purchase-value">
        <text class="purchase-main">{{product.moq}}{{product.unit}}起订</text>
        <text class="purchase-sub">加入购物车默认按起订量</text>
      </view>
    </view>
    <view class="purchase-row">
      <text class="purchase-label">库存</text>
      <view class="purchase-value">
        <text class="purchase-main stock-ok" wx:if="{{product.stock>10}}">可售 {{product.stock}}{{product.unit}}</text>
        <text class="purchase-main stock-low" wx:elif="{{product.stock>0}}">仅剩 {{product.stock}}{{product.unit}}</text>
        <text class="purchase-main stock-warn" wx:else>库存需确认</text>
      </view>
    </view>
    <view class="purchase-row">
      <text class="purchase-label">批号/效期</text>
      <view class="purchase-value">
        <text class="purchase-main">{{product.batch}}</text>
        <text class="purchase-sub">效期：{{product.expiry}}</text>
      </view>
    </view>
    <view class="purchase-row">
      <text class="purchase-label">配送</text>
      <view class="purchase-value">
        <text class="purchase-main">以收货地区和订单量核算</text>
        <text class="purchase-sub">正式下单前再次确认库存与运费</text>
      </view>
    </view>
  </view>

  <view class="pdp-block variant-block" wx:if="{{otherVariants.length}}">
    <view class="pdp-section-head">
      <view>
        <view class="pdp-section-title">同品名其他规格</view>
        <view class="pdp-section-sub">不同规格作为独立商品，价格、库存与采购条件分别计算</view>
      </view>
    </view>
    <view class="variant-list">
      <view class="variant-card" wx:for="{{otherVariants}}" wx:key="id" bindtap="goVariant" data-id="{{item.id}}">
        <image class="variant-image" src="{{item.image}}" mode="aspectFill"></image>
        <view class="variant-copy">
          <view class="variant-name">{{item.name}}</view>
          <view class="variant-spec">规格 {{item.spec}}</view>
          <view class="variant-meta">库存 {{item.stock}}{{item.unit}} · {{item.moq}}{{item.unit}}起订</view>
        </view>
        <view class="variant-price">¥{{item.price}}</view>
        <text class="variant-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="pdp-block pharmacist-entry" bindtap="service">
    <view>
      <view class="service-kicker">CUSTOMER SERVICE</view>
      <view class="service-title">采购有疑问？联系客服</view>
      <view class="service-copy">支持询价、库存效期、订单物流、资质与售后问题。</view>
    </view>
    <view class="service-arrow">→</view>
  </view>

  <view class="pdp-block info-block">
    <view class="pdp-section-head">
      <view>
        <view class="pdp-section-title">商品与资质信息</view>
        <view class="pdp-section-sub">采购前需要确认的核心资料</view>
      </view>
    </view>
    <view class="pdp-row"><text class="label">品牌</text><text>{{product.brand}}</text></view>
    <view class="pdp-row"><text class="label">生产企业</text><text>{{product.maker}}</text></view>
    <view class="pdp-row"><text class="label">批准文号</text><text>{{product.approval}}</text></view>
    <view class="pdp-row"><text class="label">储存条件</text><text>{{product.storage}}</text></view>
    <view class="pdp-row"><text class="label">效期</text><text>{{product.expiry}}</text></view>
  </view>

  <view class="pdp-block instruction-block">
    <view class="pdp-section-head instruction-head">
      <view>
        <view class="pdp-section-title">{{instructionTitle}}</view>
        <view class="pdp-section-sub" wx:if="{{product.instruction}}">以下为说明书字段展示，正式上线以经核准说明书原文为准</view>
        <view class="pdp-section-sub" wx:else>当前商品使用产品资料说明</view>
      </view>
    </view>

    <block wx:if="{{product.instruction}}">
      <view class="instruction-row"><text class="instruction-label">药品名称</text><text class="instruction-value">{{product.instruction.name}}</text></view>
      <view class="instruction-row"><text class="instruction-label">通用名称</text><text class="instruction-value">{{product.instruction.generic}}</text></view>
      <view class="instruction-row"><text class="instruction-label">规格</text><text class="instruction-value">{{product.instruction.spec}}</text></view>
      <view class="instruction-row"><text class="instruction-label">成份</text><text class="instruction-value">{{product.instruction.ingredients}}</text></view>
      <view class="instruction-row"><text class="instruction-label">功能主治 / 适应症</text><text class="instruction-value">{{product.instruction.indications}}</text></view>
      <view class="instruction-row"><text class="instruction-label">用法用量</text><text class="instruction-value">{{product.instruction.dosage}}</text></view>
      <view class="instruction-row"><text class="instruction-label">不良反应</text><text class="instruction-value">{{product.instruction.adverse}}</text></view>
      <view class="instruction-row"><text class="instruction-label">禁忌</text><text class="instruction-value">{{product.instruction.contraindications}}</text></view>
      <view class="instruction-row"><text class="instruction-label">注意事项</text><text class="instruction-value">{{product.instruction.precautions}}</text></view>
      <view class="instruction-row"><text class="instruction-label">贮藏</text><text class="instruction-value">{{product.instruction.storage}}</text></view>
      <view class="instruction-row"><text class="instruction-label">包装</text><text class="instruction-value">{{product.instruction.package}}</text></view>
      <view class="instruction-row"><text class="instruction-label">有效期</text><text class="instruction-value">{{product.instruction.expiry}}</text></view>
      <view class="instruction-row"><text class="instruction-label">批准文号</text><text class="instruction-value">{{product.instruction.approval}}</text></view>
      <view class="instruction-row"><text class="instruction-label">生产企业</text><text class="instruction-value">{{product.instruction.maker}}</text></view>
      <button class="info-link instruction-link" bindtap="instructions">查看完整说明书 / 产品资料 →</button>
    </block>

    <block wx:else>
      <view class="content-lead">{{product.sell}}</view>
      <button class="info-link instruction-link" bindtap="instructions">查看完整产品资料 →</button>
    </block>
  </view>

  <view class="pdp-block trust-block">
    <view class="trust-row">
      <view class="trust-item"><text class="strong">正规渠道</text><text>商品来源与资质可查</text></view>
      <view class="trust-item"><text class="strong">履约确认</text><text>库存、批号、效期复核</text></view>
      <view class="trust-item"><text class="strong">客服支持</text><text>报价、物流与售后协助</text></view>
    </view>
  </view>

  <view class="pdp-spacer"></view>
  <view class="pdp-bottom premium-pdp-bottom">
    <view class="pdp-mini-actions">
      <button class="pdp-icon" bindtap="toggleFav"><text class="icon-text">{{isFav?'♥':'♡'}}</text><text>常购</text></button>
      <button class="pdp-icon bag-icon" bindtap="goCart">
        <text class="icon-text">车</text><text>购物车</text><text class="mini-badge" wx:if="{{cartCount>0}}">{{cartCount}}</text>
      </button>
      <button class="pdp-icon pdp-service-mini" bindtap="service"><text>客服</text></button>
    </view>
    <button class="btn-secondary pdp-cart-btn" bindtap="addCart">加入购物车</button>
    <button class="btn-primary pdp-buy-btn" bindtap="buyNow">立即采购</button>
  </view>
</view>
