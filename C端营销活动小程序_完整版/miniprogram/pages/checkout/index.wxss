t:1.5;overflow-wrap:anywhere}.option-value,.option-link{flex:0 0 auto;max-width:42%;font-size:22rpx;color:#6f6964;text-align:right;line-height:1.45;overflow-wrap:anywhere}.option-switch{width:72rpx;height:40rpx;border-radius:999rpx;background:#d8d3cd;padding:4rpx;transition:.2s;flex:none}.option-switch.on{background:#5e4b43}.switch-dot{width:32rpx;height:32rpx;border-radius:50%;background:#fff;transition:.2s}.option-switch.on .switch-dot{transform:translateX(32rpx)}.summary-section{padding-bottom:24rpx}.summary-section .checkout-section-title{margin-bottom:12rpx}.summary-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:9rpx 0;font-size:23rpx}.summary-row>text:last-child{white-space:nowrap;flex:none}.summary-saving{color:#6d5945}.total-row{font-size:28rpx;font-weight:650;margin-top:8rpx;padding-top:16rpx;border-top:1rpx solid #ece7e0}.checkout-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;padding:26rpx 24rpx 34rpx;text-align:center}.checkout-trust>view{min-width:0;padding:0 4rpx}.trust-title{display:block;font-size:21rpx;font-weight:600;white-space:nowrap}.trust-sub{display:block;font-size:18rpx;color:#958e88;margin-top:4rpx;line-height:1.4;overflow-wrap:anywhere}.checkout-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;align-items:center;gap:16rpx;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e7e1da}.checkout-footer-total{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center}.footer-label{font-size:18rpx;color:#8e8781;white-space:nowrap}.footer-price{font-size:34rpx;font-weight:700;line-height:1.12;white-space:nowrap;max-width:100%;overflow:hidden;text-overflow:ellipsis}.footer-note{max-width:100%;font-size:18rpx;color:#8b765f;margin-top:3rpx;line-height:1.35;text-align:right}.submit-order-btn{flex:0 0 218rpx;width:218rpx;height:78rpx;min-height:78rpx;padding:0 