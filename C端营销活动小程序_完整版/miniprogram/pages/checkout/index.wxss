.checkout-page{min-height:100vh;background:#f7f4ef}.checkout-head{padding:34rpx 32rpx 26rpx;background:#fbfaf8}.checkout-title-main{font-size:42rpx;font-weight:650;letter-spacing:-1rpx}.checkout-sub-main{font-size:21rpx;color:#8e8781;line-height:1.6;margin-top:8rpx}.checkout-section{position:relative;margin-top:16rpx;padding:28rpx 32rpx;background:#fff;border-top:1rpx solid #e8e2db;border-bottom:1rpx solid #e8e2db}.section-eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#8d755d;font-weight:600}.address-line{display:flex;align-items:center;gap:12rpx;margin-top:12rpx}.address-name{font-size:30rpx;font-weight:650}.address-phone{font-size:23rpx;color:#746e68}.address-detail{font-size:22rpx;color:#7f7872;line-height:1.6;margin-top:8rpx;padding-right:42rpx}.section-arrow{position:absolute;right:30rpx;top:50%;transform:translateY(-50%);font-size:38rpx;color:#aaa29b}.checkout-section-head{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:14rpx}.checkout-section-title{font-size:30rpx;font-weight:650}.checkout-section-sub{font-size:20rpx;color:#9a938d;margin-top:4rpx}.premium-order-product{padding:22rpx 0;border-bottom:1rpx solid #ece7e0}.premium-order-product:last-child{border-bottom:0}.order-product-copy{min-width:0}.order-product-bottom{display:flex;align-items:center;gap:10rpx;margin-top:14rpx}.member-chip{min-height:34rpx;padding:0 9rpx;border-radius:5rpx;background:#f3eee8;color:#6f5a46;font-size:17rpx;display:flex;align-items:center}.checkout-option-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #ece7e0}.checkout-option-row:last-child{border-bottom:0}.option-title{font-size:24rpx;font-weight:500}.option-sub{font-size:20rpx;color:#918a84;margin-top:5rpx}.option-value,.option-link{font-size:22rpx;color:#6f6964}.option-switch{width:72rpx;height:40rpx;border-radius:999rpx;background:#d8d3cd;padding:4rpx;transition:.2s}.option-switch.on{background:#5e4b43}.switch-dot{width:32rpx;height:32rpx;border-radius:50%;background:#fff;transition:.2s}.option-switch.on .switch-dot{transform:translateX(32rpx)}.summary-section{padding-bottom:24rpx}.summary-section .checkout-section-title{margin-bottom:12rpx}.summary-row{display:flex;align-items:center;justify-content:space-between;padding:9rpx 0;font-size:23rpx}.summary-saving{color:#6d5945}.total-row{font-size:28rpx;font-weight:650;margin-top:8rpx;padding-top:16rpx;border-top:1rpx solid #ece7e0}.checkout-trust{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;padding:26rpx 24rpx 34rpx;text-align:center}.trust-title{display:block;font-size:21rpx;font-weight:600}.trust-sub{display:block;font-size:18rpx;color:#958e88;margin-top:4rpx}.checkout-footer{position:fixed;left:0;right:0;bottom:0;z-index:20;display:grid;grid-template-columns:1fr 230rpx;gap:18rpx;align-items:center;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #e7e1da}.checkout-footer-total{display:flex;flex-direction:column;align-items:flex-end}.footer-label{font-size:18rpx;color:#8e8781}.footer-price{font-size:34rpx;font-weight:700}.footer-note{font-size:18rpx;color:#8b765f;margin-top:2rpx}.submit-order-btn{height:80rpx;min-height:80rpx;font-size:25rpx}.bottom-space{height:132rpx}
