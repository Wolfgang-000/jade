.checkout-page{min-height:100vh;background:var(--bg);padding-bottom:calc(110rpx + env(safe-area-inset-bottom))}
.checkout-head{padding:34rpx 32rpx 26rpx;background:var(--surface-soft)}
.checkout-title-main{font-size:42rpx;font-weight:650;letter-spacing:-1rpx}
.checkout-sub-main{font-size:21rpx;color:#8E8781;line-height:1.6;margin-top:8rpx}
.checkout-section{position:relative;margin-top:16rpx;padding:28rpx 32rpx;background:#fff;border-top:1rpx solid var(--border);border-bottom:1rpx solid var(--border)}
.section-eyebrow{font-size:17rpx;letter-spacing:3rpx;color:#8D755D;font-weight:600}
.address-line{display:flex;align-items:center;gap:12rpx;margin-top:12rpx;min-width:0;padding-right:42rpx}
.address-name{min-width:0;font-size:30rpx;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.address-phone{font-size:23rpx;color:#746E68;white-space:nowrap;flex:none}
.address-detail{font-size:22rpx;color:#7F7872;line-height:1.6;margin-top:8rpx;padding-right:42rpx;overflow-wrap:anywhere}
.section-arrow{position:absolute;right:30rpx;top:50%;transform:translateY(-50%);font-size:38rpx;color:#AAA29B}
.checkout-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18rpx;margin-bottom:14rpx}
.checkout-section-head>view{min-width:0}
.checkout-section-title{font-size:30rpx;font-weight:650}
.checkout-section-sub{font-size:20rpx;color:var(--text-3);margin-top:4rpx}
.premium-order-product{padding:22rpx 0;border-bottom:1rpx solid var(--divider)}
.premium-order-product:last-child{border-bottom:0}
.order-product-copy{min-width:0}
.order-product-copy .row-title{min-width:0;line-height:1.45;overflow-wrap:anywhere}
.order-product-copy .caption{min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.order-product-bottom{display:flex;align-items:center;gap:10rpx;margin-top:14rpx;flex-wrap:wrap;min-width:0}
.member-chip{min-height:34rpx;padding:0 9rpx;border-radius:5rpx;background:#F3EEE8;color:#6F5A46;font-size:17rpx;display:flex;align-items:center;white-space:nowrap}
.order-product-bottom .price-small{max-width:100%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.checkout-option-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid var(--divider)}
.checkout-option-row:last-child{border-bottom:0}
.checkout-option-row>view:first-child{flex:1 1 auto;min-width:0}
.option-title{font-size:24rpx;font-weight:500}
.option-sub{font-size:20rpx;color:#918A84;margin-top:5rpx;line-height:1.5;overflow-wrap:anywhere}
.option-value,.option-link{flex:0 1 42%;min-width:0;max-width:42%;font-size:22rpx;color:var(--text-2);text-align:right;line-height:1.45;overflow-wrap:anywhere}
.option-switch{width:72rpx;height:40rpx;border-radius:999rpx;background:#D8D3CD;padding:4rpx;transition:.2s;flex:none}
.option-switch.on{background:var(--brand)}
.switch-dot{width:32rpx;height:32rpx;border-radius:50%;background:#fff;transition:.2s}
.option-switch.on .switch-dot{transform:translateX(32rpx)}
.summary-section{padding-bottom:24rpx}
.summary-section .checkout-section-title{margin-bottom:12rpx}
.summary-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:9rpx 0;font-size:23rpx}
.summary-row>text:first-child{min-width:0}
.summary-row>text:last-child{white-space:nowrap;flex:none}
.summary-saving{color:#6D5945}
.total-row{font-size:28rpx;font-weight:650;margin-top:8rpx;padding-top:16rpx;border-top:1rpx solid var(--divider)}
.checkout-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8rpx;padding:26rpx 24rpx 34rpx;text-align:center}
.checkout-trust>view{min-width:0;padding:0 4rpx}
.trust-title{display:block;font-size:21rpx;font-weight:600;white-space:nowrap}
.trust-sub{display:block;font-size:18rpx;color:#958E88;margin-top:4rpx;line-height:1.4;overflow-wrap:anywhere}
.checkout-footer{position:fixed;left:0;right:0;bottom:0;z-index:30;display:flex;align-items:center;gap:16rpx;padding:12rpx 20rpx calc(12rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid var(--border)}
.checkout-footer-total{flex:1 1 auto;min-width:0;display:flex;flex-direction:column;align-items:flex-end;justify-content:center}
.footer-label{font-size:18rpx;color:#8E8781;white-space:nowrap}
.footer-price{max-width:100%;font-size:34rpx;font-weight:700;line-height:1.12;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.footer-note{max-width:100%;font-size:18rpx;color:#8B765F;margin-top:3rpx;line-height:1.35;text-align:right;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
.submit-order-btn{flex:0 0 218rpx;width:218rpx;height:78rpx;min-height:78rpx;padding:0 16rpx;font-size:24rpx;white-space:nowrap;border-radius:var(--radius-md)}

@media (max-width:360px){
  .checkout-section{padding-left:26rpx;padding-right:26rpx}
  .submit-order-btn{flex-basis:198rpx;width:198rpx}
  .footer-note{font-size:17rpx}
}
