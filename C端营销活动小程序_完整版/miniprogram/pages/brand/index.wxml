<view wx:if="{{brand}}">
  <view class="brand-hero"><image src="{{brand.hero}}" mode="aspectFill"></image><view class="brand-hero-copy"><view class="eyebrow" style="color:#fff">BRAND HOUSE</view><view class="h1">{{brand.name}}</view></view></view>
  <view class="section"><view class="h2">品牌理念</view><view class="section-sub">{{brand.desc}}。品牌馆优先讲清品牌定位、专业背景和核心产品，而不是立即堆促销。</view></view>
  <view class="section safe-bottom"><view class="section-title">核心产品</view><view class="product-grid" style="margin-top:22rpx">
    <view class="product-card" wx:for="{{products}}" wx:key="id" bindtap="product" data-id="{{item.id}}">
      <view class="product-card__image"><image src="{{item.image}}" mode="aspectFill"></image></view>
      <view class="product-card__name">{{item.name}}</view><view class="product-card__meta">{{item.spec}}</view><view class="price-small" style="margin-top:8rpx">¥{{item.price}}</view>
    </view>
  </view></view>
</view>