.item{padding:28rpx 0;border-bottom:1rpx solid var(--divider)}
.top{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;min-width:0}
.copy{min-width:0}
.name{font-size:30rpx;font-weight:600;line-height:1.4;overflow-wrap:anywhere}
.sub{font-size:23rpx;color:#7D756F;margin-top:8rpx;line-height:1.55;overflow-wrap:anywhere}
.status{font-size:21rpx;color:var(--brand);white-space:nowrap;flex:none}
.meta{font-size:21rpx;color:var(--text-3);margin-top:16rpx;overflow-wrap:anywhere}
.more{font-size:24rpx;color:#4E4742;font-weight:600;margin-top:16rpx}
