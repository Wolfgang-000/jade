<view class="item" bindtap="open">
  <view class="top">
    <view class="copy"><view class="name">{{activity.title || activity.name}}</view><view class="sub">{{activity.subtitle}}</view></view>
    <view class="status">{{activity.status==='live'?'进行中':'即将开始'}}</view>
  </view>
  <view class="meta">{{activity.start}} — {{activity.end}}</view>
  <view class="more">{{activity.status==='live'?'查看采购活动':'查看预告'}} →</view>
</view>
