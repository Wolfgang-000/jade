.card{background:#fff;border:1rpx solid #ebe6e0;border-radius:16rpx;overflow:hidden}.pic{height:248rpx;background:#f2ece5;display:flex;align-items:center;justify-content:center;color:#aaa19a;font-size:22rpx}.product-image{width:100%;height:100%}.body{padding:20rpx}.name{font-size:26rpx;line-height:1.45;font-weight:600;min-height:76rpx}.spec{font-size:22rpx;color:#8d857f;margin-top:6rpx}.price-row{margin-top:16rpx;display:flex;align-items:baseline;gap:10rpx}.price{font-size:34rpx;color:#9b1c1f;font-weight:700}.old{font-size:21rpx;color:#aaa19b;text-decoration:line-through}.buy{margin-top:18rpx;height:68rpx;line-height:68rpx;background:#9b1c1f;color:#fff;border-radius:10rpx;font-size:24rpx;font-weight:600;padding:0}.buy::after{border:0}
